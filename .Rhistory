mean(pat$Age >= 65, na.rm = TRUE)
mean(pat$Age >= 80, na.rm = TRUE)
for (v in c("Gender", "County", "AdmissionType", "Department", "DiagnosisCategory")) {
print(round(prop.table(table(pat[[v]])), 3))
}
mean(pat$Comorbidity_Count >= 1, na.rm = TRUE)
mean(pat$Comorbidity_Count >= 3, na.rm = TRUE)
mean(pat$PreviousAdmissions >= 1)
mean(pat$Readmission30)
aggregate(LOS ~ AdmissionType, data = pat, FUN = function(x) c(mean = mean(x), median = median(x)))
aggregate(LOS ~ Department, data = pat, FUN = function(x) c(mean = mean(x), median = median(x)))
table(pat$AdmissionType, pat$Department)   # day cases only in Ortho and Surgery
table(pat$Department, pat$DiagnosisCategory)
# LOS and follow-ups are counts, so compare mean and variance
c(mean(pat$LOS, na.rm = TRUE), var(pat$LOS, na.rm = TRUE))
c(mean(pat$OutpatientFollowUps, na.rm = TRUE), var(pat$OutpatientFollowUps, na.rm = TRUE))
#### 3. Q2 length of stay ----
covs <- "Age + Gender + County + AdmissionType + Department + DiagnosisCategory +
Comorbidity_Count + PreviousAdmissions"
f_los <- as.formula(paste("LOS ~", covs))
d2 <- na.omit(pat[, all.vars(f_los)])
# poisson first, to check the dispersion
