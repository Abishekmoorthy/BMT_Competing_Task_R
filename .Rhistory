aggregate(LOS ~ Department + AdmissionType, data = pat, FUN = mean)
# part (b)
d6b <- droplevels(subset(d2, Department %in% c("Orthopaedics", "Surgery")))
d6b$Department <- relevel(d6b$Department, ref = "Orthopaedics")
m6b_add <- glm.nb(as.formula(paste("LOS ~", covs6, "+ AdmissionType + Department")), data = d6b)
m6b_int <- glm.nb(as.formula(paste("LOS ~", covs6, "+ AdmissionType * Department")), data = d6b)
anova(m6b_add, m6b_int)
#### Figures for the report ----
cols <- c(Elective = "#2a78d6", Emergency = "#eb6834", "Day Case" = "#1baf7a")
# Figure 1: mean LOS (with 95% CI) by department and admission type
cell <- do.call(rbind, lapply(split(d3, list(d3$Department, d3$AdmissionType), drop = TRUE), function(s) {
m <- mean(s$LOS); se <- sd(s$LOS) / sqrt(nrow(s))
data.frame(Department = s$Department[1], AdmissionType = s$AdmissionType[1],
mean = m, lo = m - 1.96 * se, hi = m + 1.96 * se)
}))
ggplot(cell, aes(x = mean, y = Department, colour = AdmissionType)) +
geom_errorbarh(aes(xmin = lo, xmax = hi), height = 0, linewidth = 0.8,
position = position_dodge(width = 0.5)) +
geom_point(size = 2.5, position = position_dodge(width = 0.5)) +
scale_colour_manual(values = cols) +
labs(x = "Average length of stay (days)", y = NULL, colour = NULL) +
theme_minimal() + theme(legend.position = "top")
# Figure 2: readmission rate by previous admissions and by comorbidities
rate_plot <- function(x, lab) {
x <- pmin(x, 4)   # group 4+ together, the top groups are tiny
r <- aggregate(pat$Readmission30, list(k = x), mean)
ggplot(r, aes(factor(k, labels = c("0", "1", "2", "3", "4+")), x * 100)) +
geom_col(fill = "#2a78d6", width = 0.6) +
labs(x = lab, y = "Readmitted within 30 days (%)") + theme_minimal()
}
rate_plot(pat$PreviousAdmissions, "Admissions in previous 2 years")
rate_plot(pat$Comorbidity_Count, "Number of comorbidities")
# Figure 3: average follow-ups by department
fu_dep <- aggregate(OutpatientFollowUps ~ Department, data = pat, mean)
ggplot(fu_dep, aes(OutpatientFollowUps, reorder(Department, OutpatientFollowUps))) +
geom_col(fill = "#2a78d6", width = 0.6) +
labs(x = "Average follow-up appointments", y = NULL) + theme_minimal()
# MS6061 project - St. Colm's University Hospital patient data
# Run from the folder that contains stcolms_patient_data.csv.
# The figures used in the report are written to figures/
library(MASS)      # glm.nb
library(car)       # leveneTest
library(ggplot2)
dir.create("figures", showWarnings = FALSE)
pat <- read.csv("stcolms_patient_data.csv", stringsAsFactors = FALSE)
pat <- read.csv("C:/Users/Abishek/Downloads/stcolms_patient_data.csv", stringsAsFactors = FALSE)
# MS6061 project - St. Colm's University Hospital patient data
# Run from the folder that contains stcolms_patient_data.csv.
# The figures used in the report are written to figures/
library(MASS)      # glm.nb
library(car)       # leveneTest
library(ggplot2)
dir.create("figures", showWarnings = FALSE)
pat <- read.csv("C:/Users/Abishek/Downloads/stcolms_patient_data.csv", stringsAsFactors = FALSE)
str(pat)
#### 1. Cleaning ----
# gender was typed ten different ways (F, female, MALE, m ...), first letter is enough
table(pat$Gender)
pat$Gender <- ifelse(tolower(substr(trimws(pat$Gender), 1, 1)) == "f", "Female", "Male")
# county: sort out the case first, then the typos
pat$County <- tools::toTitleCase(tolower(trimws(pat$County)))
pat$County[pat$County == "Limrick"] <- "Limerick"
pat$County[pat$County %in% c("Tipp", "Tipperay")] <- "Tipperary"
table(pat$County)
# ages of -1, 0, 120, 150 and 999 are not possible for this (adult) population
sort(pat$Age)[c(1:3, 1496:1500)]
pat$Age[pat$Age < 18 | pat$Age > 105] <- NA
sum(pat$Age == 95, na.rm = TRUE)      # 33 patients at exactly 95, looks top-coded
# LOS: two negatives, plus 380 and 420 days which are almost certainly keying errors
sort(pat$LOS)[c(1:3, 1495:1500)]
pat$LOS[pat$LOS < 0 | pat$LOS > 365] <- NA
# reference levels: Elective, Medicine (largest dept), Limerick, "Other" diagnosis
pat$Gender <- factor(pat$Gender)
pat$County <- factor(pat$County, levels = c("Limerick", "Clare", "Cork", "Tipperary", "Other"))
pat$AdmissionType <- factor(pat$AdmissionType, levels = c("Elective", "Emergency", "Day Case"))
pat$Department <- factor(pat$Department,
levels = c("Medicine", "Cardiology", "Oncology", "Orthopaedics", "Surgery"))
pat$DiagnosisCategory <- factor(pat$DiagnosisCategory,
levels = c("Other", "Cancer", "Cardiovascular", "Musculoskeletal", "Respiratory"))
colSums(is.na(pat))
# is the missingness random? follow-ups are only missing for day cases
table(pat$AdmissionType, is.na(pat$OutpatientFollowUps))
tapply(pat$Readmission30, is.na(pat$Comorbidity_Count), mean)
#### 2. Q1 descriptive summary ----
summary(pat[, c("Age", "Comorbidity_Count", "PreviousAdmissions", "LOS", "OutpatientFollowUps")])
mean(pat$Age >= 65, na.rm = TRUE)
mean(pat$Age >= 80, na.rm = TRUE)
for (v in c("Gender", "County", "AdmissionType", "Department", "DiagnosisCategory")) {
print(round(prop.table(table(pat[[v]])), 3))
}
mean(pat$Comorbidity_Count >= 1, na.rm = TRUE)
mean(pat$Comorbidity_Count >= 3, na.rm = TRUE)
mean(pat$PreviousAdmissions >= 1)
mean(pat$Readmission30)
aggregate(LOS ~ AdmissionType, data = pat, FUN = function(x) c(mean = mean(x), median = median(x)))
aggregate(LOS ~ Department, data = pat, FUN = function(x) c(mean = mean(x), median = median(x)))
table(pat$AdmissionType, pat$Department)   # day cases only in Ortho and Surgery
table(pat$Department, pat$DiagnosisCategory)
# LOS and follow-ups are counts, so compare mean and variance
c(mean(pat$LOS, na.rm = TRUE), var(pat$LOS, na.rm = TRUE))
c(mean(pat$OutpatientFollowUps, na.rm = TRUE), var(pat$OutpatientFollowUps, na.rm = TRUE))
#### 3. Q2 length of stay ----
covs <- "Age + Gender + County + AdmissionType + Department + DiagnosisCategory +
Comorbidity_Count + PreviousAdmissions"
f_los <- as.formula(paste("LOS ~", covs))
d2 <- na.omit(pat[, all.vars(f_los)])
# poisson first, to check the dispersion
los_pois <- glm(f_los, family = poisson, data = d2)
disp_pois <- sum(residuals(los_pois, type = "pearson")^2) / los_pois$df.residual
disp_pois                                   # well above 1
los_nb <- glm.nb(f_los, data = d2)
summary(los_nb)
AIC(los_pois, los_nb)
sum(residuals(los_nb, type = "pearson")^2) / los_nb$df.residual
drop1(los_nb, test = "Chisq")               # LR test per variable (theta held fixed)
los_rr <- exp(cbind(RR = coef(los_nb), confint.default(los_nb)))
round(los_rr, 3)
exp(10 * coef(los_nb)["Age"])               # per decade of age
#### 4. Q3 LOS across departments ----
d3 <- pat[!is.na(pat$LOS), ]
d3$logLOS <- log1p(d3$LOS)                  # log(LOS + 1): skewed, and day cases have 0
aov3 <- aov(logLOS ~ Department, data = d3)
summary(aov3)
ss <- summary(aov3)[[1]][["Sum Sq"]]
eta2 <- ss[1] / sum(ss)
leveneTest(logLOS ~ Department, data = d3)
shapiro.test(residuals(aov3))
TukeyHSD(aov3)
# variances are unequal, so check without that assumption
oneway.test(logLOS ~ Department, data = d3, var.equal = FALSE)
kruskal.test(LOS ~ Department, data = d3)
pairwise.wilcox.test(d3$LOS, d3$Department, p.adjust.method = "holm")
# day cases only exist in two departments, so repeat for inpatients only
d3_inp <- droplevels(subset(d3, AdmissionType != "Day Case"))
aov3_inp <- aov(logLOS ~ Department, data = d3_inp)
summary(aov3_inp)
TukeyHSD(aov3_inp)
aggregate(LOS ~ Department, data = d3_inp, FUN = function(x) c(mean = mean(x), median = median(x)))
#### 5. Q4 30-day readmission ----
f_readm <- as.formula(paste("Readmission30 ~", covs, "+ LOS"))
d4 <- na.omit(pat[, all.vars(f_readm)])
readm_glm <- glm(f_readm, family = binomial, data = d4)
sum(d4$Readmission30) / (length(coef(readm_glm)) - 1)   # events per parameter
summary(readm_glm)
drop1(readm_glm, test = "Chisq")
round(exp(cbind(OR = coef(readm_glm), confint.default(readm_glm))), 3)
# AUC via the rank (Mann-Whitney) formula
p_hat <- fitted(readm_glm)
y <- d4$Readmission30
n1 <- sum(y == 1); n0 <- sum(y == 0)
auc <- (sum(rank(p_hat)[y == 1]) - n1 * (n1 + 1) / 2) / (n1 * n0)
# Hosmer-Lemeshow, 10 groups
grp <- cut(p_hat, breaks = quantile(p_hat, probs = seq(0, 1, 0.1)), include.lowest = TRUE)
obs <- tapply(y, grp, sum)
expd <- tapply(p_hat, grp, sum)
n_g <- tapply(y, grp, length)
hl <- sum((obs - expd)^2 / (expd * (1 - expd / n_g)))
c(AUC = auc, HL = hl, p = pchisq(hl, df = 8, lower.tail = FALSE))
# McFadden pseudo R2
r2_mcf <- 1 - as.numeric(logLik(readm_glm)) / as.numeric(logLik(update(readm_glm, . ~ 1)))
r2_mcf
#### 6. Q5 outpatient follow-ups ----
f_fu <- as.formula(paste("OutpatientFollowUps ~", covs, "+ LOS"))
d5 <- na.omit(pat[, all.vars(f_fu)])
fu_pois <- glm(f_fu, family = poisson, data = d5)
disp_fu <- sum(residuals(fu_pois, type = "pearson")^2) / fu_pois$df.residual
disp_fu                                     # about 1, so no overdispersion here
# for comparison only: theta runs off towards infinity (warnings expected),
# i.e. the negative binomial collapses back to the poisson
fu_nb <- glm.nb(f_fu, data = d5)
AIC(fu_pois, fu_nb)
summary(fu_pois)
drop1(fu_pois, test = "Chisq")
round(exp(cbind(RR = coef(fu_pois), confint.default(fu_pois))), 3)
# sensitivity: drop the patient with 40 follow-ups
round(exp(coef(update(fu_pois, data = subset(d5, OutpatientFollowUps < 30)))), 3)
# sensitivity: treat the missing day-case follow-ups as 0
d5b <- pat
d5b$OutpatientFollowUps[is.na(d5b$OutpatientFollowUps)] <- 0
round(exp(coef(update(fu_pois, data = na.omit(d5b[, all.vars(f_fu)])))), 3)
#### 7. Q6 admission type x department ----
# Day cases don't occur in Medicine, Cardiology or Oncology, so the full
# interaction has 3 empty cells (R would return NA coefficients).
# (a) Elective vs Emergency, which exist in all five departments
# (b) all three types, but only within Orthopaedics and Surgery
covs6 <- "Age + Gender + County + DiagnosisCategory + Comorbidity_Count + PreviousAdmissions"
d6 <- droplevels(subset(d2, AdmissionType != "Day Case"))
m6_add <- glm.nb(as.formula(paste("LOS ~", covs6, "+ AdmissionType + Department")), data = d6)
m6_int <- glm.nb(as.formula(paste("LOS ~", covs6, "+ AdmissionType * Department")), data = d6)
anova(m6_add, m6_int)
AIC(m6_add, m6_int)
# emergency vs elective rate ratio inside each department
b <- coef(m6_int)
V <- vcov(m6_int)
emerg <- sapply(levels(d6$Department), function(dep) {
k <- setNames(rep(0, length(b)), names(b))
k["AdmissionTypeEmergency"] <- 1
if (dep != "Medicine") k[paste0("AdmissionTypeEmergency:Department", dep)] <- 1
est <- sum(k * b)
se <- sqrt(drop(t(k) %*% V %*% k))
exp(c(RR = est, lower = est - 1.96 * se, upper = est + 1.96 * se))
})
round(t(emerg), 2)
d6b <- droplevels(subset(d2, Department %in% c("Orthopaedics", "Surgery")))
m6b_add <- glm.nb(as.formula(paste("LOS ~", covs6, "+ AdmissionType + Department")), data = d6b)
m6b_int <- glm.nb(as.formula(paste("LOS ~", covs6, "+ AdmissionType * Department")), data = d6b)
anova(m6b_add, m6b_int)
#### 8. Figures (saved into figures/ and used in the report) ----
blue <- "#2a78d6"
type_cols <- c(Elective = "#2a78d6", Emergency = "#eb6834", "Day Case" = "#1baf7a")
theme_rep <- theme_minimal(base_size = 9) +
theme(panel.grid.minor = element_blank(), plot.title = element_text(size = 9))
# Figure 1: mean LOS with 95% CI by department and admission type
cell <- aggregate(LOS ~ Department + AdmissionType, data = d3,
FUN = function(x) c(m = mean(x), se = sd(x) / sqrt(length(x))))
cell <- data.frame(cell[, 1:2], mean = cell$LOS[, "m"], se = cell$LOS[, "se"])
cell$lo <- cell$mean - 1.96 * cell$se
cell$hi <- cell$mean + 1.96 * cell$se
cell$Department <- factor(cell$Department,
levels = c("Surgery", "Cardiology", "Orthopaedics", "Medicine", "Oncology"))
dodge <- position_dodge(width = 0.6)
fig1 <- ggplot(cell, aes(x = Department, y = mean, colour = AdmissionType)) +
geom_linerange(aes(ymin = lo, ymax = hi), linewidth = 0.9, position = dodge) +
geom_point(size = 2.2, position = dodge) +
geom_text(aes(y = hi, label = sprintf("%.1f", mean), group = AdmissionType), hjust = -0.3, size = 2.6,
colour = "grey30", position = dodge) +
scale_colour_manual(values = type_cols, labels = c("Elective", "Emergency", "Day case")) +
scale_y_continuous(limits = c(0, 21.5), breaks = seq(0, 20, 5)) +
coord_flip() +
labs(x = NULL, y = "Average length of stay (days), with 95% CI", colour = NULL) +
theme_rep + theme(legend.position = "top", panel.grid.major.y = element_blank())
ggsave("figures/fig1_los.pdf", fig1, width = 6, height = 2.9)
# Figure 2: readmission by prior admissions / comorbidities, follow-ups by department
rate_plot <- function(x, xlab) {
r <- aggregate(pat$Readmission30, list(k = pmin(x, 4)), mean)   # 4+ grouped together
r$k <- factor(r$k, labels = c("0", "1", "2", "3", "4+"))
ggplot(r, aes(k, 100 * x)) +
geom_col(fill = blue, width = 0.62) +
geom_text(aes(label = sprintf("%.0f%%", 100 * x)), vjust = -0.4, size = 2.6) +
scale_y_continuous(limits = c(0, 50)) +
labs(x = xlab, y = "Readmitted within 30 days (%)") +
theme_rep + theme(panel.grid.major.x = element_blank())
}
ggsave("figures/fig2a_readm_prev.pdf",
rate_plot(pat$PreviousAdmissions, "Admissions in previous 2 years"), width = 2.4, height = 2.2)
ggsave("figures/fig2b_readm_como.pdf",
rate_plot(pat$Comorbidity_Count, "Number of comorbidities"), width = 2.4, height = 2.2)
fu_dep <- aggregate(OutpatientFollowUps ~ Department, data = pat, FUN = mean)
fig2c <- ggplot(fu_dep, aes(reorder(Department, OutpatientFollowUps), OutpatientFollowUps)) +
geom_col(fill = blue, width = 0.62) +
geom_text(aes(label = sprintf("%.1f", OutpatientFollowUps)), hjust = -0.25, size = 2.6) +
scale_y_continuous(limits = c(0, 9)) +
coord_flip() +
labs(x = NULL, y = "Mean follow-up appointments") +
theme_rep + theme(panel.grid.major.y = element_blank())
ggsave("figures/fig2c_followups.pdf", fig2c, width = 2.4, height = 2.2)
# Figure 3: model checks - NB deviance residuals and ANOVA Q-Q plot
diag_df <- data.frame(fitted = fitted(los_nb), res = residuals(los_nb, type = "deviance"))
fig3a <- ggplot(diag_df, aes(fitted, res)) +
geom_point(alpha = 0.35, size = 0.8, colour = blue) +
geom_hline(yintercept = 0, linetype = 2) +
scale_x_log10() +
labs(x = "Fitted LOS (log scale)", y = "Deviance residual") + theme_rep
ggsave("figures/fig3a_nb_resid.pdf", fig3a, width = 3, height = 2.3)
fig3b <- ggplot(data.frame(r = residuals(aov3)), aes(sample = r)) +
stat_qq(alpha = 0.35, size = 0.8, colour = blue) + stat_qq_line(linetype = 2) +
labs(x = "Theoretical quantiles", y = "ANOVA residual") + theme_rep
ggsave("figures/fig3b_anova_qq.pdf", fig3b, width = 3, height = 2.3)
#### 9. Numbers quoted in the report (quick check) ----
round(c(
n_q2 = nrow(d2), disp_pois = disp_pois, theta = los_nb$theta,
aic_pois = AIC(los_pois), aic_nb = AIC(los_nb),
rr_emerg = los_rr["AdmissionTypeEmergency", 1], rr_decade = exp(10 * coef(los_nb)["Age"]),
rr_como = los_rr["Comorbidity_Count", 1],
anova_F = summary(aov3)[[1]][1, "F value"], eta2 = eta2,
readm_events = sum(d4$Readmission30), auc = auc, hl = hl, r2_mcf = r2_mcf,
disp_fu = disp_fu, aic_fu_pois = AIC(fu_pois),
q6_lr = anova(m6_add, m6_int)[2, "LR stat."], q6b_lr = anova(m6b_add, m6b_int)[2, "LR stat."]
), 3)
